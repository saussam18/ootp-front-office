{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ui && corepack enable && pnpm install --frozen-lockfile && pnpm build",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "index.py": { "excludeFiles": "{data/snapshots/**,ui/**,ui_templates/**,out/**,public/**,.venv/**}" }
  }
}
